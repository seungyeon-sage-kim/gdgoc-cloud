STEP_CHECKS = {0: "billing", 1: "start", 2: "database", 3: "base", 4: "topics", 5: "web", 6: "workers", 8: "push",
               11: "eventarc", 12: "schedule", 13: "warmup", 14: "github", 15: "github", 16: "deploys", 26: "paused"}  # fmt: skip


def check_name(key) -> str | None:
    """A check's name from a name or an old step number."""
    if isinstance(key, int) or str(key).isdigit():
        return STEP_CHECKS.get(int(key))
    return key if key in CHECKS else None


def run_check(cloud: Cloud, key) -> tuple:
    name = check_name(key)
    result = Result()
    try:
        CHECKS[name][1](cloud, result)
        status = "ok" if result.passed else "NOT"
    except NotBuilt as reason:
        result.lines.append(("-", str(reason)))
        status = "-"
    if name in {STEP_CHECKS.get(int(step)) for step in skipped()}:
        status += " (skipped)"
    return status, result.lines


def check(args: list) -> None:
    cloud = cloud_from_settings()
    report = "--report" in args
    names = []
    for arg in args:
        if arg == "--report":
            continue
        name = check_name(arg)
        if not name:
            die(f"No check {arg}. The checks: {', '.join(CHECKS)}")
        if name not in names:
            names.append(name)
    # Pausing is not a lab task, so a full check or report leaves it out (./lab check paused still runs it)
    names = names or [n for n in CHECKS if n != "paused"]
    out = []
    if report:
        out.append(f"Cloud Ticketing lab report, {datetime.now().isoformat(timespec='minutes')}")
        out.append(f"project {cloud.project} (number {cloud.number}), {cloud.region}, admin {cloud.admin}")
        repo = own_repo()
        out.append(f"GitHub {repo or '-'}")
        out.append(f"lab parts: {', '.join(read_tfvars().get('lab_parts', [])) or 'none'}")
        out.append(f"skipped steps: {', '.join(sorted(skipped(), key=int)) or 'none'}")
        out.append("")
    failed = False
    for name in names:
        status, lines = run_check(cloud, name)
        failed |= status.startswith("NOT")
        out.append(f"{name:<9} {CHECKS[name][0]:<40} {status}")
        if len(names) == 1 or report or status.startswith("NOT"):
            out += [f"  {kind:<5} {text}" for kind, text in lines]
    if report:
        web = (
            cloud.gcloud("run", "revisions", "list", "--service", "web", "--region", cloud.region, "--limit", "10")
            or []
        )
        out.append("")
        out.append("web revisions: " + ", ".join(r["metadata"]["name"] for r in web))
        REPORT.write_text("\n".join(out) + "\n")
        out.append(f"\nSaved to {REPORT}. Submit that file.")
    print("\n".join(out))
    sys.exit(1 if failed and not report else 0)


