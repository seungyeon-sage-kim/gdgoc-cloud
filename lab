def event_document(
    event_id: str, now: datetime, opens_in: int | None = None, seats: int = 200, waitlist: int = 50, title: str = ""
) -> tuple[dict, list]:
    """The events/ document for ./lab event, with the fields of shared/models.Event, and what is
    wrong with it (the admin form's rules, web/admin.py). now is a Korea-time datetime.
    Signups open 2 hours ago (or in opens_in minutes) and close tomorrow 23:00; the event is the
    day after tomorrow, 19:00 to 21:00, and attendance is confirmed by 09:00 that day."""
    event_id = event_id.strip().lower()
    title = title.strip() or f"실습 행사 {event_id}"
    errors = []
    if not EVENT_ID.match(event_id):
        errors.append("The ID takes 3 to 40 lowercase letters, digits and hyphens, starting with a letter or digit.")
    if not 1 <= seats <= 5000:
        errors.append("--seats must be between 1 and 5000.")
    if not 0 <= waitlist <= 5000:
        errors.append("--waitlist must be between 0 and 5000.")
    if len(title) > 80:
        errors.append("--title must be 80 characters or fewer.")
    minute = now.astimezone(KST).replace(second=0, microsecond=0)
    opens = minute + timedelta(minutes=opens_in) if opens_in is not None else minute - timedelta(hours=2)
    midnight = minute.replace(hour=0, minute=0)
    closes = (midnight + timedelta(days=1)).replace(hour=23)
    starts = (midnight + timedelta(days=2)).replace(hour=19)
    if closes <= opens:
        errors.append("--opens-in is too far away: signups close tomorrow at 23:00.")
    document = {
        "id": event_id,
        "title": title,
        "summary": "./lab event로 만든 실습용 행사",
        "description": "부하 테스트와 실습에 쓰는 행사입니다.",
        "venue": "온라인",
        "starts_at": starts.isoformat(),
        "ends_at": starts.replace(hour=21).isoformat(),
        "opens_at": opens.isoformat(),
        "closes_at": closes.isoformat(),
        "confirm_deadline": starts.replace(hour=9).isoformat(),
        "seat_limit": seats,
        "waitlist_limit": waitlist,
        "published": True,
        "poster_version": "",
        "created_at": now.astimezone(KST).isoformat(timespec="seconds"),
    }
    return document, errors


def firestore_fields(document: dict) -> dict:
    """A plain document as Firestore REST fields: text, whole numbers, true/false."""

    def value(v):
        if isinstance(v, bool):
            return {"booleanValue": v}
        if isinstance(v, int):
            return {"integerValue": str(v)}
        return {"stringValue": str(v)}

    return {key: value(v) for key, v in document.items()}


def event(args: list) -> None:
    parser = argparse.ArgumentParser(prog="./lab event", description="Create a published event in Firestore.")
    parser.add_argument("id", help="the last part of the event's address: /events/ID")
    parser.add_argument("--opens-in", type=int, metavar="MINUTES", help="signups open this many minutes from now")
    parser.add_argument("--seats", type=int, default=200)
    parser.add_argument("--waitlist", type=int, default=50)
    parser.add_argument("--title", default="")
    opts = parser.parse_args(args)
    cloud = cloud_from_settings()
    now = datetime.now(KST)
    document, errors = event_document(opts.id, now, opts.opens_in, opts.seats, opts.waitlist, opts.title)
    if errors:
        die("\n".join(errors))
    # Straight into Firestore, as the admin form would save it; createDocument refuses an ID that exists
    status, answer = cloud.post(
        f"https://firestore.googleapis.com/v1/projects/{cloud.project}/databases/(default)/documents/events"
        f"?documentId={document['id']}",
        {"fields": firestore_fields(document)},
    )
    page = f"{cloud.url('web')}/events/{document['id']}"
    if status == 409:
        die(f"An event {document['id']} already exists: {page}\nPick another ID.")
    if status == 404:
        die("No Firestore database yet. Build the lab first: ./lab up PROJECT_ID")
    if status != 200:
        die(f"Firestore refused the event ({status}): {answer.get('error', {}).get('message', '')}")
    opens = datetime.fromisoformat(document["opens_at"])
    when = "open now" if opens <= now else f"open at {opens:%H:%M} (in {round((opens - now).total_seconds() / 60)} min)"
    closes = datetime.fromisoformat(document["closes_at"])
    print(
        f"{document['seat_limit']} seats, waitlist {document['waitlist_limit']}. Signups {when}, close {closes:%m-%d %H:%M}."
    )
    print(f"Event {document['id']} is published: {page}")


