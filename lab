def pause() -> None:
    cloud = cloud_from_settings()
    for job in housekeeping_schedulers(cloud):
        name = job["name"].split("/")[-1]
        sh(
            [
                "gcloud",
                "scheduler",
                "jobs",
                "pause",
                name,
                "--location",
                cloud.region,
                "--project",
                cloud.project,
                "--quiet",
            ]
        )
        print(f"The Scheduler job {name} is paused: housekeeping stops running every 5 minutes.")
    # Pre-warm may have left web at 3 instances; with the job paused nothing would lower it again,
    # and idle minimum instances are billed. The service-level minimum makes no new revision.
    web = cloud.run_api("services/web") or {}
    if (web.get("scaling") or {}).get("minInstanceCount", 0):
        sh(
            [
                "gcloud",
                "run",
                "services",
                "update",
                "web",
                "--min",
                "0",
                "--region",
                cloud.region,
                "--project",
                cloud.project,
                "--quiet",
            ],
            capture=True,
        )
        print("web's minimum instances are back to 0 (pre-warm had left some running).")
    repo = own_repo()
    if repo:
        sh(["gh", "variable", "set", "DEPLOY_ENABLED", "--repo", repo, "--body", "false"], capture=True)
        print(f"Deploys from {repo} are off (DEPLOY_ENABLED=false).")
    print("Everything else stays for the IaC session. To resume: Cloud Scheduler → the job → Resume.")


