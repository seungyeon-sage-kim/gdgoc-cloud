def billing_problem(cloud: Cloud) -> str:
    """Why the project can't run the lab yet, or "" when its billing is fine."""
    billing = cloud.gcloud("billing", "projects", "describe", cloud.project, project=False)
    if billing is None:
        said = "\n".join(cloud.error.splitlines()[-6:]) or "(nothing)"
        return f"Could not read the billing of project {cloud.project}. gcloud said:\n{said}"
    if not billing.get("billingEnabled"):
        return (
            f"Project {cloud.project} has no billing account linked. Link one: ☰ → Billing → Link a billing account."
        )
    return ""


def chosen_project() -> str:
    """./lab up with no ID: the lab's project once it is set up, else the project Cloud Shell
    shows (gcloud's current project), after the student confirms it by name."""
    built = read_tfvars().get("project_id")
    if built:
        return built
    project = sh(["gcloud", "config", "get-value", "project"], capture=True, check=False).strip()
    if not project:
        die("No project is selected. In the Console, pick your lab project at the top, then reopen Cloud Shell.")
    name = sh(["gcloud", "projects", "describe", project, "--format=value(name)"], capture=True, check=False).strip()
    print(f'Cloud Shell is using the project "{name or project}" (ID {project}).')
    try:
        answer = input("Build the lab in this project? Type y and press Enter: ")
    except EOFError:
        answer = ""
    if answer.strip().lower() not in ("y", "yes"):
        die("Nothing built. Pick the lab project at the top of the Console, then run ./lab up again.")
    return project


def prepare(project: str) -> tuple[Cloud, dict]:
    """What start and up share: tools, the gcloud sign-in, the project and its billing, the settings."""
    values = read_tfvars()
    if values.get("project_id") and values["project_id"] != project:
        die(f"The lab is set up for {values['project_id']}. To start over in {project}: ./lab down first.")
    tools()
    account = sh(["gcloud", "config", "get-value", "account"], capture=True, check=False).strip()
    if not account:
        die("gcloud is not signed in. Run: gcloud auth login")
    cloud = Cloud(project)
    if not cloud.gcloud("projects", "describe", project, project=False):
        die(f"{account} cannot see project {project}. Check the ID in the Console's project picker.")
    problem = billing_problem(cloud)
    if problem:
        die(problem)
    sh(["gcloud", "config", "set", "project", project, "--quiet"], capture=True)
    if not values:
        values = {
            "project_id": project,
            "github_repo_id": "0",  # your copy's ID, set by ./lab github
            "admin_emails": [account],
            "lab_parts": ["start"],
        }
        write_tfvars(values)
    # Cloud Shell starts with no git identity, and git commit refuses to run without one
    for key, value in (("user.email", account), ("user.name", account.split("@")[0])):
        if subprocess.run(["git", "config", "--global", key], capture_output=True).returncode:
            sh(["git", "config", "--global", key, value])
    return cloud, values


