# ---------------------------------------------------------------- GitHub


def gh(*args) -> str | None:
    done = subprocess.run(["gh", *args], capture_output=True, text=True, stdin=subprocess.DEVNULL)
    return done.stdout.strip() if done.returncode == 0 else None


def made_from_template(repo: str) -> bool:
    return (gh("api", f"repos/{repo}", "-q", ".template_repository.full_name") or "").lower() == TEMPLATE.lower()


def folder_repo() -> str | None:
    """The GitHub repository this folder was cloned from (OWNER/NAME), wherever ./lab is run from."""
    done = subprocess.run(["gh", "repo", "view", "--json", "nameWithOwner", "-q", ".nameWithOwner"],
                          capture_output=True, text=True, cwd=REPO, stdin=subprocess.DEVNULL)  # fmt: skip
    return done.stdout.strip() if done.returncode == 0 else None


def own_repo() -> str | None:
    """The student's copy: LAB_REPO if set, else this folder's origin, else USER/gdgoc-tickets.
    Only a repository GitHub says was made from the template counts, so ./lab never sets
    variables on, or turns off deploys of, some other repository with the same name."""
    candidates = [os.environ.get("LAB_REPO"), folder_repo()]
    login = gh("api", "user", "-q", ".login")
    if login:
        candidates.append(f"{login}/{COPY_NAME}")
    for repo in candidates:
        if repo and repo.lower() != TEMPLATE.lower() and made_from_template(repo):
            return repo
    return None


# ---------------------------------------------------------------- Terraform


def terraform_env() -> dict:
    env = dict(os.environ)
    # Terraform signs in with Application Default Credentials; without them, a one-hour
    # token from the gcloud login
    adc = subprocess.run(["gcloud", "auth", "application-default", "print-access-token"], capture_output=True)
    if adc.returncode:
        env["GOOGLE_OAUTH_ACCESS_TOKEN"] = sh(["gcloud", "auth", "print-access-token"], capture=True).strip()
    return env


def terraform(*args, capture: bool = True, env: dict | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(
        ["terraform", f"-chdir={INFRA}", *args], capture_output=capture, text=True, env=env, stdin=subprocess.DEVNULL
    )


def link_settings() -> None:
    """infra/terraform.tfvars and infra/backend.hcl point at ~/.gdgoc-lab, so every clone shares them.
    A real file there belongs to another setup (production), and the lab leaves it alone."""
    for name in ("terraform.tfvars", "backend.hcl"):
        link, target = INFRA / name, HOME / name
        if link.is_symlink():
            if link.readlink() != target:
                link.unlink()
                link.symlink_to(target)
        elif link.exists():
            die(f"infra/{name} here is not the lab's. Run ./lab from a fresh clone of the lab repository.")
        else:
            link.symlink_to(target)


def clear_stale_lock(env: dict) -> None:
    """A run stopped in the middle (Cloud Shell shuts down after 40 minutes without input, or Ctrl+C)
    leaves Terraform's lock in the state bucket, and every later run would stop on it. Only the
    student knows whether another ./lab is still running, so ask before removing it."""
    backend = (HOME / "backend.hcl").read_text() if (HOME / "backend.hcl").exists() else ""
    bucket, prefix = re.search(r'bucket\s*=\s*"([^"]+)"', backend), re.search(r'prefix\s*=\s*"([^"]+)"', backend)
    if not bucket:
        return
    where = f"gs://{bucket.group(1)}/{prefix.group(1) if prefix else ''}/default.tflock".replace(
        "//default", "/default"
    )
    found = subprocess.run(["gcloud", "storage", "cat", where], capture_output=True, text=True)
    if found.returncode:
        return  # no lock
    lock = json.loads(found.stdout or "{}")
    print(
        f"Terraform's state is locked by a run that did not finish: {lock.get('Who', '?')}, {lock.get('Created', '?')[:19]}."
    )
    print("That happens when Cloud Shell shut down, or the command was stopped, in the middle of a run.")
    try:
        answer = input("If no other ./lab is running now, type y and press Enter to unlock and continue: ")
    except EOFError:
        answer = ""
    if answer.strip().lower() not in ("y", "yes"):
        die(f"Still locked. To unlock later: terraform -chdir=infra force-unlock {lock.get('ID', 'LOCK_ID')}")
    done = terraform("force-unlock", "-force", lock.get("ID", ""), env=env)
    if done.returncode:
        die(f"Could not unlock:\n{(done.stderr or done.stdout).strip()}")
    print("Unlocked.")


def ensure_terraform(env: dict) -> None:
    link_settings()
    if not (INFRA / ".terraform" / "terraform.tfstate").exists():
        # Makes the state bucket the first time, then connects this clone to it
        sh([str(INFRA / "bootstrap-state.sh")], env=env)


def waitlist_index(cloud: Cloud) -> str | None:
    """The composite index the waitlist query needs: registrations by event_id, status, created_at."""
    for index in cloud.gcloud("firestore", "indexes", "composite", "list", "--database=(default)") or []:
        fields = [f.get("fieldPath") for f in index.get("fields", [])]
        if "/collectionGroups/registrations/" in index.get("name", "") and fields[:3] == [
            "event_id",
            "status",
            "created_at",
        ]:
            return index["name"]
    return None


