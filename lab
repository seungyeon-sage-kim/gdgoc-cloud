    )  # fmt: skip
    sys.exit(done.returncode)


def timed_get(url: str) -> tuple[float, str]:
    """Seconds one request took, and the instance that answered (X-Served-By)."""
    started = time.perf_counter()
    try:
        with urllib.request.urlopen(url, timeout=120) as answer:
            answer.read()
            who = answer.headers.get("X-Served-By", "")
    except urllib.error.HTTPError as error:
        who = f"HTTP {error.code}"
    return time.perf_counter() - started, who


def coldstart() -> None:
    cloud = cloud_from_settings()
    web = web_service(cloud)
    minimum = (web.get("scaling") or {}).get("minInstanceCount", 0)
    print(f"web's minimum instances: {minimum}")
    url = f"{web.get('uri') or cloud.url('web')}/health"
    times = []
    for n in range(1, 7):
        seconds, who = timed_get(url)
        times.append(seconds)
        print(f"request {n}  {seconds:5.2f} s  {who}", flush=True)
    print(f"\nFirst request {times[0]:.2f} s, typical {statistics.median(times[1:]):.2f} s (median of the next 5).")
    if minimum:
        print(f"web keeps {minimum} instance(s) running, so there is no cold start to see now.")
    print(
        "A cold start shows only after about 15 minutes with no traffic and minimum instances 0. If the\n"
        "first request was as fast as the rest, an instance was still running: close the site's tabs,\n"
        "wait 15 minutes, and run this again."
    )


