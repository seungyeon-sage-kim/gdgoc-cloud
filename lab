def latest_run(repo: str, workflow: str) -> dict:
    found = gh("run", "list", "--repo", repo, "--workflow", workflow, "--limit", "1", "--json",
               "databaseId,url,status,conclusion")  # fmt: skip
    runs = json.loads(found or "[]")
    return runs[0] if runs else {}


def run_workflow(repo: str, workflow: str, minutes: int = 10) -> dict:
    """Start a workflow on main and wait until it finishes: its run (databaseId, url, conclusion)."""
    before = latest_run(repo, workflow).get("databaseId")
    for _ in range(6):  # a new copy's workflows take a moment to show up on GitHub
        if gh("workflow", "run", workflow, "--repo", repo, "--ref", "main") is not None:
            break
        time.sleep(10)
    else:
        die(f"Could not start {workflow} in {repo}. Start it by hand: Actions → Sign-in test → Run workflow")
    deadline = time.monotonic() + minutes * 60
    while time.monotonic() < deadline:
        time.sleep(10)
        run = latest_run(repo, workflow)
        if run.get("databaseId") not in (None, before) and run.get("status") == "completed":
            return run
    die(f"{workflow} did not finish in {minutes} minutes. See Actions in {repo}.")


def sign_in_test(repo: str) -> tuple[bool, str]:
    """Run the Sign-in test: (passed, the run's page). A first failure because the new permission
    had not spread yet (getAccessToken denied) is tried once more, a minute later."""
    for attempt in (1, 2):
        run = run_workflow(repo, "sign-in-test.yml")
        if run.get("conclusion") == "success":
            return True, run.get("url", "")
        failed_log = gh("run", "view", str(run["databaseId"]), "--repo", repo, "--log-failed") or ""
        if attempt == 1 and "getAccessToken" in failed_log:
            print(
                "  Google Cloud had not spread the new permission yet (getAccessToken denied). Trying again in a minute."
            )
            time.sleep(60)
            continue
        return False, run.get("url", "")
    return False, ""


