def member_of(cloud: Cloud, who: str, repo_id: str = "") -> str:
    if who == "pubsub-agent":
        return f"serviceAccount:{cloud.pubsub_agent}"
    if who == "github":
        return (
            f"principalSet://iam.googleapis.com/projects/{cloud.number}/locations/global/"
            f"workloadIdentityPools/github/attribute.repository_id/{repo_id}"
        )
    return f"serviceAccount:{cloud.sa(who)}"


def granted(cloud: Cloud) -> set:
    """Every (member, kind, name, role) that exists now, on the resources of the design."""
    resources = {(kind, name.format(p=cloud.project)) for _, kind, name, _, _, _ in DESIGN}
    found = set()
    for kind, name in sorted(resources):
        target = cloud.sa(name) if kind == "sa" else name
        for binding in cloud.policy(kind, target).get("bindings", []):
            for member in binding.get("members", []):
                found.add((member, kind, name, binding["role"]))
    return found


def iam() -> None:
    cloud = cloud_from_settings()
    print("Reading the permissions (about 30 seconds).")
    exists = granted(cloud)
    print("Who may do what. ✓ = in place now; (step N) = you or a shortcut add it then.\n")
    repo = own_repo()
    repo_id = (gh("api", f"repos/{repo}", "-q", ".id") if repo else None) or "YOUR_REPO_ID"
    labels = {
        "project": "project",
        "bucket": "bucket",
        "secret": "secret",
        "topic": "topic",
        "subscription": "subscription",
        "service": "service",
        "job": "job",
        "sa": "account",
        "repo": "registry",
    }
    whos = list(SERVICE_ACCOUNTS) + ["pubsub-agent", "github"]
    titles = {**SERVICE_ACCOUNTS, "pubsub-agent": "Pub/Sub's own service agent", "github": "your GitHub repository"}
    for who in whos:
        rows = [d for d in DESIGN if d[0] == who]
        if not rows:
            continue
        name = (
            "Pub/Sub service agent"
            if who == "pubsub-agent"
            else "GitHub (principalSet)"
            if who == "github"
            else f"tickets-{who}"
        )
        print(f"{name}  ({titles[who]})")
        member = member_of(cloud, who, repo_id)
        for _, kind, res, role, step, why in rows:
            res = res.format(p=cloud.project)
            role = role.format(p=cloud.project)
            here = (member, kind, res, role) in exists
            shown = "tickets-" + res if kind == "sa" else "assets" if kind == "bucket" else res
            where = f"{labels[kind]} {shown}".strip()
            title = ROLE_TITLES.get(role, "Change web's scaling (custom)" if role.endswith("webScaler") else role)
            mark = "✓" if here else " "
            later = "" if here else f"  (step {step})"
            print(f"  {mark} {where:<35} {title:<31} {why}{later}")
        print()
    # Project-wide roles nobody designed: a sign of a grant made in the wrong place
    project_policy = cloud.policy("project", "")
    designed = {(member_of(cloud, d[0]), d[3]) for d in DESIGN if d[1] == "project"}
    extra = [
        (m, b["role"])
        for b in project_policy.get("bindings", [])
        for m in b.get("members", [])
        if "tickets-" in m and (m, b["role"]) not in designed
    ]
    for member, role in extra:
        print(f"! {member.split(':')[1]} has {role} on the whole project. The design grants it on one resource.")


