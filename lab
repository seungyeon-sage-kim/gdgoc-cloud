# ---------------------------------------------------------------- settings


def read_tfvars(path: Path | None = None) -> dict:
    """The lab's terraform.tfvars: one `name = value` per line, values written as JSON."""
    path = path or TFVARS
    values = {}
    if path.exists():
        for line in path.read_text().splitlines():
            match = re.match(r"^\s*(\w+)\s*=\s*(.+?)\s*$", line)
            if match and not line.lstrip().startswith("#"):
                values[match[1]] = json.loads(match[2])
    return values


def write_tfvars(values: dict, path: Path | None = None) -> None:
    path = path or TFVARS
    path.parent.mkdir(parents=True, exist_ok=True)
    lines = ["# Written by ./lab. lab_parts lists what shortcuts and skips have built (infra/lab.tf)."]
    width = max(len(k) for k in values)
    lines += [f"{k.ljust(width)} = {json.dumps(v, ensure_ascii=False)}" for k, v in values.items()]
    path.write_text("\n".join(lines) + "\n")


def settings() -> dict:
    values = read_tfvars()
    if not values.get("project_id"):
        die("No lab settings yet. Start with: ./lab start PROJECT_ID")
    return values


def add_parts(values: dict, parts: list) -> list:
    """Every part on so far plus the new ones, in the order of infra/lab.tf."""
    on = set(values.get("lab_parts", [])) | set(parts)
    return [p for p in PARTS if p in on]


def skipped() -> dict:
    return json.loads(SKIPPED.read_text()) if SKIPPED.exists() else {}


def record_skip(step: int) -> None:
    done = skipped()
    done[str(step)] = datetime.now().isoformat(timespec="minutes")
    SKIPPED.write_text(json.dumps(done, indent=1))


# ---------------------------------------------------------------- Google Cloud


class Cloud:
    """The student's project, read through gcloud and the Cloud Run API."""

    def __init__(self, project: str, region: str = "asia-northeast3", admin: str = ""):
        self.project, self.region, self.admin = project, region, admin
        self._number = None
        self._token = None
        self.error = ""  # what gcloud said when the last command failed

    def gcloud(self, *args, project: bool = True):
        """gcloud's JSON answer, or None if the command failed (usually: it doesn't exist)."""
        cmd = ["gcloud", *args, "--format=json", "--quiet"] + (["--project", self.project] if project else [])
        done = subprocess.run(cmd, capture_output=True, text=True, stdin=subprocess.DEVNULL)
        if done.returncode:
            self.error = (done.stderr or "").strip()
            return None
        return json.loads(done.stdout or "null")

    @property
    def token(self) -> str:
        if self._token is None:
            self._token = sh(["gcloud", "auth", "print-access-token"], capture=True).strip()
        return self._token

    def post(self, url: str, body: dict) -> tuple[int, dict]:
        """POST to a Google API with the gcloud login: (HTTP status, the answer)."""
        request = urllib.request.Request(
            url,
            data=json.dumps(body).encode(),
            method="POST",
            headers={"Authorization": f"Bearer {self.token}", "Content-Type": "application/json"},
        )
        try:
            with urllib.request.urlopen(request, timeout=30) as answer:
                return answer.status, json.load(answer)
        except urllib.error.HTTPError as error:
            try:
                return error.code, json.load(error)
            except ValueError:
                return error.code, {}

    def exists(self, *args) -> bool:
        return self.gcloud(*args) is not None

    @property
    def number(self) -> str:
        if self._number is None:
            found = self.gcloud("projects", "describe", self.project, project=False) or {}
            self._number = found.get("projectNumber", "")
        return self._number

    def api(self, url: str):
        """GET a Google API with the gcloud login. None for 404."""
        request = urllib.request.Request(url, headers={"Authorization": f"Bearer {self.token}"})
        try:
            with urllib.request.urlopen(request, timeout=30) as answer:
                return json.load(answer)
        except urllib.error.HTTPError as error:
            if error.code in (403, 404):
                return None
            raise

    def run_api(self, path: str):
        """Cloud Run's v2 view of a service or job: the same field names as infra/run.tf."""
        return self.api(f"https://run.googleapis.com/v2/projects/{self.project}/locations/{self.region}/{path}")

    def policy(self, kind: str, name: str) -> dict:
        commands = {
            "project": ["projects", "get-iam-policy", self.project],
            "secret": ["secrets", "get-iam-policy", name],
            "topic": ["pubsub", "topics", "get-iam-policy", name],
            "subscription": ["pubsub", "subscriptions", "get-iam-policy", name],
            "service": ["run", "services", "get-iam-policy", name, "--region", self.region],
            "job": ["run", "jobs", "get-iam-policy", name, "--region", self.region],
            "sa": ["iam", "service-accounts", "get-iam-policy", name],
            "bucket": ["storage", "buckets", "get-iam-policy", f"gs://{name}"],
            "repo": ["artifacts", "repositories", "get-iam-policy", name, "--location", self.region],
        }
        return self.gcloud(*commands[kind]) or {}

    # Names, the same ones infra/lab.tf builds
    def sa(self, key: str) -> str:
        return f"tickets-{key}@{self.project}.iam.gserviceaccount.com"

    @property
    def registry(self) -> str:
        return f"{self.region}-docker.pkg.dev/{self.project}/gdgoc-tickets"

    @property
    def pubsub_agent(self) -> str:
        return f"service-{self.number}@gcp-sa-pubsub.iam.gserviceaccount.com"

    def url(self, service: str) -> str:
        return f"https://{service}-{self.number}.{self.region}.run.app"

    @property
    def provider(self) -> str:
        return f"projects/{self.number}/locations/global/workloadIdentityPools/github/providers/gdgoc-tickets"


def members(policy: dict, role: str) -> set:
    return {m for b in policy.get("bindings", []) if b.get("role") == role for m in b.get("members", [])}


def sh(cmd: list, capture: bool = False, check: bool = True, **kw) -> str:
    done = subprocess.run(cmd, capture_output=capture, text=True, **kw)
    if check and done.returncode:
        die(f"Stopped: {' '.join(cmd[:4])} failed.\n{(done.stderr or '').strip()}" if capture else "")
    return done.stdout if capture else ""


