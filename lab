def up(project: str) -> None:
    cloud, values = prepare(project)
    print("Building the whole lab with Terraform: about 15 minutes the first time, a few minutes after that.")
    print("Safe to run again: a rerun puts every setting you changed in the Console back to the code's settings.")
    if "web" not in values.get("lab_parts", []):
        # First build. Every load-test visitor comes from one Cloud Shell address, and web allows
        # 100 signups a minute per address by default; 2 seconds more per ticket keeps the
        # ticket-worker queue long enough to watch (docs/load-test.md). Kept on reruns.
