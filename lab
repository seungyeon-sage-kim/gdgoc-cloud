    if not has("locust"):
        die("locust is not installed. In Cloud Shell run ./scripts/setup-cloudshell.sh, then this again.")
    cloud = cloud_from_settings()
    web = web_service(cloud)
    host = web.get("uri") or cloud.url("web")
