    print("They wait for the opening and sign up the moment it opens, with @example.com addresses (never mailed).")
    print("Where to look while it runs (graphs arrive 3 to 5 minutes late):")
    print("  Cloud Run → web → Observability: instance count, request latency")
    print("  Pub/Sub → Subscriptions → ticket-worker → Metrics: unacked messages")
    print(f"  Firestore → Firestore Studio → event_counts → {opts.event_id}: held and issued\n", flush=True)
    done = subprocess.run(
