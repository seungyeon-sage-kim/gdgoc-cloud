# Changes a plan always shows that mean nothing: every deploy names web's revision, and the code doesn't
DRIFT_NOISE = {("google_cloud_run_v2_service", "template.revision")}
ACTION_WORDS = {("create",): "create", ("update",): "update", ("delete",): "destroy"}


def changed_paths(before, after, unknown, path: str = "") -> list:
    """Attributes whose planned value is known and differs from the live one (list positions left out)."""
    if unknown is True:
        return []
    if isinstance(before, dict) and isinstance(after, dict):
        unknown = unknown if isinstance(unknown, dict) else {}
        found = []
        for key in sorted(set(before) | set(after)):
            found += changed_paths(before.get(key), after.get(key), unknown.get(key), f"{path}.{key}".lstrip("."))
        return found
    if isinstance(before, list) and isinstance(after, list) and len(before) == len(after):
        unknown = unknown if isinstance(unknown, list) else [None] * len(after)
        return [p for b, a, u in zip(before, after, unknown, strict=False) for p in changed_paths(b, a, u, path)]
    return [] if before == after else [path]


def drift_lines(plan: dict) -> tuple[list, int]:
    """One line per resource the plan would change, and how many were hidden as noise."""
    lines, hidden = [], 0
    for change in plan.get("resource_changes", []):
        actions = tuple(change["change"]["actions"])
        if actions in (("no-op",), ("read",)):
            continue
        word = ACTION_WORDS.get(actions, "replace")
        detail = []
        if word == "update":
            c = change["change"]
            paths = list(dict.fromkeys(changed_paths(c.get("before"), c.get("after"), c.get("after_unknown"))))
            detail = [p for p in paths if (change["type"], p) not in DRIFT_NOISE]
            if paths and not detail:
                hidden += 1
                continue
        more = f": {', '.join(detail[:4])}" + (", ..." if len(detail) > 4 else "") if detail else ""
        lines.append(f"  {word:<8} {change['address']}{more}")
    return lines, hidden


def drift() -> None:
    cloud = cloud_from_settings()
    values = settings()
    keep = ["push"] if "topics" in values.get("lab_parts", []) and push_state(cloud) == "set" else []
    parts = add_parts(values, keep)  # the parts ./lab up would apply again
    env = terraform_env()
    ensure_terraform(env)
    print("Comparing the live project with the code (terraform plan; nothing is changed). About a minute.", flush=True)
    plan = terraform("plan", "-input=false", "-no-color", f"-var=lab_parts={json.dumps(parts)}", "-out=drift.tfplan",
                     env=env)  # fmt: skip
    try:
        if plan.returncode:
            print("\n".join(((plan.stdout or "") + (plan.stderr or "")).strip().splitlines()[-25:]), file=sys.stderr)
            die("terraform plan stopped on the error above.")
        shown = terraform("show", "-json", "drift.tfplan", env=env)
    finally:
        (INFRA / "drift.tfplan").unlink(missing_ok=True)
    lines, hidden = drift_lines(json.loads(shown.stdout or "{}"))
    if lines:
        print(f"\n{len(lines)} differences between the live project and the code (infra/*.tf):")
        print("\n".join(lines))
    else:
        print("\nThe live project matches the code.")
    if hidden:
        print("(Not shown: web's revision name, which every deploy sets.)")
    if lines:
        print("\n./lab up applies the code again: that is the reset, and it removes these differences.")


# ---------------------------------------------------------------- main


def main(argv: list) -> None:
    os.environ["PATH"] = f"{Path.home() / 'bin'}:{Path.home() / '.local/bin'}:{os.environ['PATH']}"
    command, args = (argv[0], argv[1:]) if argv else ("", [])
    if command:
        # Every command, not only Terraform's: in a folder set up for something else (production),
        # its GitHub repository is not the student's copy, and ./lab pause would switch off its deploys
        link_settings()
    if command == "start" and len(args) == 1:
        start(args[0])
    elif command == "up" and len(args) <= 1:
        up(args[0] if args else chosen_project())
    elif command == "github" and not args:
        github()
    elif command == "mail" and args in (["on"], ["off"]):
        mail(args[0])
    elif command == "event" and args:
        event(args)
    elif command == "load" and args:
        load(args)
    elif command == "coldstart" and not args:
        coldstart()
    elif command == "drift" and not args:
        drift()
    elif command in SHORTCUTS and not args:
        shortcut(command)
    elif command == "iam":
        iam()
    elif command == "env":
        show_env(args[0] if args else "")
    elif command == "code":
        code()
    elif command == "check":
        check(args)
    elif command == "skip" and len(args) == 1:
        skip(args[0])
    elif command == "pause":
        pause()
    elif command == "down":
        down()
    else:
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        sys.exit(2)


if __name__ == "__main__":
    main(sys.argv[1:])
