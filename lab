def adopt(cloud: Cloud, parts: list, env: dict) -> None:
    """Hand Terraform the pieces of these parts that someone already made, so it doesn't make them twice."""
    state = set((terraform("state", "list", env=env).stdout or "").split())
    for part in parts:
        for address, import_id in adoptable(cloud, part):
            if address in state:
                continue
            found = import_id()
            if not found:
                continue
            print(f"  found {address.split('.')[-1]} already made; Terraform takes it over")
            done = terraform("import", "-input=false", "-no-color", address, found, env=env)
            if done.returncode:
                die(f"Could not take over {address}:\n{done.stdout[-1500:]}{done.stderr[-1500:]}")


def worker_urls(cloud: Cloud) -> set:
    """Both addresses of ticket-worker: the one with the project number, and the older one."""
    worker = cloud.run_api("services/ticket-worker") or {}
    return {u.rstrip("/") for u in [worker.get("uri", ""), *worker.get("urls", []), cloud.url("ticket-worker")] if u}


def push_state(cloud: Cloud) -> str:
    """ticket-worker's subscription: "pull" (or not there), "set" when it pushes to ticket-worker
    signed as tickets-pubsub-push, "wrong" when it pushes some other way."""
    push = (cloud.gcloud("pubsub", "subscriptions", "describe", "ticket-worker") or {}).get("pushConfig", {})
    if not push.get("pushEndpoint"):
        return "pull"
    signer = push.get("oidcToken", {}).get("serviceAccountEmail", "")
    right = push["pushEndpoint"].rstrip("/") in worker_urls(cloud) and signer == cloud.sa("pubsub-push")
    return "set" if right else "wrong"


def up_parts(values: dict, cloud: Cloud) -> list:
    """What ./lab up applies: UP_PARTS, push when the student already switched to Push, and
    every part already on (trust once ./lab github built it)."""
    return add_parts(values, UP_PARTS + (["push"] if push_state(cloud) == "set" else []))


def apply(cloud: Cloud, parts: list) -> None:
    """Turn these parts on in terraform.tfvars, take over what exists, and apply."""
    values = settings()
    parts = add_parts(values, parts)
    # A subscription Terraform owns that the student switched to Push by hand stays Push:
    # Terraform takes the change over instead of undoing it. Only a finished switch counts
    # (ticket-worker's URL, signed as tickets-pubsub-push), so Terraform never completes it for them.
    if "topics" in parts and "push" not in parts:
        state = push_state(cloud)
        if state == "set":
            parts = add_parts(values, parts + ["push"])
        elif state == "wrong":
            print(
                "  ticket-worker's subscription pushes, but not to ticket-worker signed as tickets-pubsub-push.\n"
                "  Terraform sets it back to Pull; switch it to Push again in the Console (./lab check push)."
            )
    values["lab_parts"] = parts
    write_tfvars(values)
    env = terraform_env()
    ensure_terraform(env)
    clear_stale_lock(env)
    adopt(cloud, parts, env)
    log = HOME / "apply.log"
    for attempt in range(1, 5):
        plan = terraform("plan", "-input=false", "-no-color", "-out=lab.tfplan", env=env)
        done = plan
        if plan.returncode == 0:
            done = terraform("apply", "-input=false", "-no-color", "lab.tfplan", env=env)
        output = (plan.stdout or "") + (plan.stderr or "") + (done.stdout or "") + (done.stderr or "")
        log.write_text(output)
        (INFRA / "lab.tfplan").unlink(missing_ok=True)
        if done.returncode == 0:
            return
        if not RETRYABLE.search(output) or attempt == 4:
            print("\n".join(output.strip().splitlines()[-25:]), file=sys.stderr)
            die(f"Stopped on the error above (full output: {log}).")
        print(f"Google Cloud is not ready yet. Trying again in a minute ({attempt} of 3).")
        time.sleep(60)


