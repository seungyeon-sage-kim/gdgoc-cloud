# Copy to .env and edit. On Cloud Run, Terraform sets these as environment
# variables (infra/run.tf), and secrets come from Secret Manager.

# Events are not configured here: create them at http://localhost:8080/admin.
# A fresh database gets nine sample events (shared/demo.py).

# Names on the site, in emails and in calendar feeds
# SITE_NAME=Cloud Ticketing
# ORGANIZER=GDGoC Yonsei 클라우드 파트

# Secrets (Secret Manager on Cloud Run)
TICKET_SECRET=change-this-to-a-long-random-string
SESSION_SECRET=local-session-secret-change-me

# Who runs events and who checks people in. They sign in with a code sent by
# email; locally the email lands in http://localhost:8080/dev/outbox.
ADMIN_EMAILS=organizer@example.com
STAFF_EMAILS=door@example.com

# Sign in with Google: an OAuth web client whose JavaScript origins include
# http://localhost and http://localhost:8080
# GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com

# Email. Locally it goes to the outbox folder. To send real mail, verify a domain
# with Resend and create an API key:
# MAIL_BACKEND=smtp
# MAIL_FROM=tickets@mail.example.com
# SMTP_PASSWORD=re_your_api_key

# Local demo knobs: how slow the ticket worker is, and how often it fails (0 to 1)
WORKER_DELAY_MS=1200
WORKER_FAIL_RATE=0
